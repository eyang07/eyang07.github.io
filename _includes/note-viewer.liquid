<div class="note-actions">
  <a class="btn btn-sm z-depth-0" href="{{ include.pdf | relative_url }}" target="_blank">
    <i class="fas fa-file-pdf"></i> View PDF
  </a>
  <a class="btn btn-sm z-depth-0" href="{{ include.tex | relative_url }}" target="_blank">
    <i class="fas fa-code"></i> LaTeX source
  </a>
  {% if include.original %}
    <a class="btn btn-sm z-depth-0" href="{{ include.original | relative_url }}" target="_blank">
      <i class="fas fa-pen"></i> Handwritten source
    </a>
  {% endif %}
</div>

<iframe
  class="note-pdf"
  src="{{ include.pdf | relative_url }}"
  title="{{ include.title | default: 'Class notes PDF' }}"
></iframe>

<style>
  .note-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.75rem 0 1rem;
  }

  .note-pdf {
    width: 100%;
    min-height: 78vh;
    border: 1px solid var(--global-divider-color);
    border-radius: 6px;
    background: var(--global-card-bg-color);
    margin-bottom: 1.75rem;
  }

  .handwritten-sources {
    margin: -0.5rem 0 1rem;
  }

  .handwritten-sources a {
    margin-right: 0.75rem;
    white-space: nowrap;
  }

  @media (max-width: 576px) {
    .note-pdf {
      min-height: 70vh;
    }
  }
</style>
